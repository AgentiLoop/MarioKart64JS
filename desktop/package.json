{
  "name": "mariokart64js",
  "productName": "MarioKart64JS",
  "version": "0.0.3",
  "description": "MarioKart64JS desktop (Electron for Windows and Linux; macOS uses webkit/build.sh)",
  "author": "Todd Bruss",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "game": "cd .. && npm run build && rm -rf desktop/game && rsync -a dist/ desktop/game/",
    "start": "electron .",
    "dist": "npm run dist:win && npm run dist:linux",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "games.gokart.mariokart64js",
    "artifactName": "MarioKart64JS-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json",
      "icon/MK64JS.png",
      "game/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}

